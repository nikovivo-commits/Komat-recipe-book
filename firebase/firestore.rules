rules_version = '2';
// Who can do what in the Komat kitchen book.
//   Cooks join on their phone with the kitchen code. They can read everything, tick lists,
//   add tasks, orders and problem reports, and add photos.
//   Sous chefs, head chefs and devs (whoever builds and looks after the app) have the full
//   rights: they also change recipes, station lists, the rota, events and settings, see the
//   kitchen code and manage the people list. The owner who set the kitchen up always keeps them.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function mePath() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    function ownerPath() { return /databases/$(db)/documents/private/owner; }
    function joinPath() { return /databases/$(db)/documents/private/join; }
    function member() { return signedIn() && exists(mePath()); }
    function owner() { return signedIn() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid; }
    function fullRole(r) { return r in ['sous', 'admin', 'dev']; }
    function admin() { return member() && fullRole(get(mePath()).data.role); }
    function isOwnerDoc(uid) { return exists(ownerPath()) && get(ownerPath()).data.uid == uid; }
    function goodName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 40; }

    // the head chef's account, claimed once when the kitchen is set up (email sign-in only)
    match /private/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid;
    }
    // the kitchen code cooks join with
    match /private/join {
      allow read: if admin();
      allow write: if admin() && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string && request.resource.data.code.size() >= 6 && request.resource.data.code.size() <= 40;
    }
    // everyone who can open the book
    match /members/{uid} {
      allow read: if member() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'code', 'at'])
        && goodName(request.resource.data)
        && ((request.resource.data.role == 'cook' && exists(joinPath()) && request.resource.data.code == get(joinPath()).data.code)
          || (request.resource.data.role == 'admin' && owner()));
      // you can change your own name; anyone with the full rights can also change roles, but the owner keeps the full rights
      allow update: if goodName(request.resource.data) && (
          (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ink', 'hand'])
            && (!('ink' in request.resource.data) || (request.resource.data.ink is string && request.resource.data.ink.size() <= 12))
            && (!('hand' in request.resource.data) || (request.resource.data.hand is string && request.resource.data.hand.size() <= 20)))
          || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role'])
            && request.resource.data.role in ['cook', 'sous', 'admin', 'dev'] && (fullRole(request.resource.data.role) || !isOwnerDoc(uid))));
      allow delete: if signedIn() && (request.auth.uid == uid || (admin() && !isOwnerDoc(uid)));
    }
    // the book itself
    match /{coll}/{id} {
      allow read: if member() && coll in ['recipes', 'settings', 'schedules', 'events', 'checks', 'prep', 'orders', 'boards', 'bugs', 'blobs'];
      allow write: if (admin() && coll in ['recipes', 'settings', 'schedules', 'events'])
        || (member() && coll in ['checks', 'prep', 'orders', 'boards', 'bugs', 'blobs']);
    }
    // days off: everyone sees them (and why). You ask for yourself; the head chef or sous chef can ask for anyone
    // and is the only one who approves or refuses. Priority moves someone else's plain request between accepted
    // and waiting (and back when it is withdrawn), and a request can note whose draft week it moved.
    match /dayoff/{id} {
      function fair(d) { return d.kind in ['ask', 'urgent', 'paid', 'unpaid'] && d.date is string && d.person is string && (!('note' in d) || (d.note is string && d.note.size() <= 300)); }
      allow read: if member();
      allow create: if fair(request.resource.data) && (admin()
        || (member() && request.resource.data.uid == request.auth.uid && request.resource.data.status in ['ok', 'waiting']));
      allow update: if fair(request.resource.data) && (admin()
        || (member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bumpedBy', 'moved'])
          && request.resource.data.status in ['ok', 'waiting'] && resource.data.status in ['ok', 'waiting']));
      allow delete: if admin() || (member() && resource.data.uid == request.auth.uid);
    }
    // cover points: everyone sees them. A phone may only write what spending them leaves behind (a spend, up to 20,
    // and up to 2 for whoever gave way); covers, bonuses and the points a saved week brings come from the chefs.
    match /points/{id} {
      allow read: if member();
      allow create, update: if admin()
        || (member() && request.resource.data.kind == 'spend' && request.resource.data.n is int && request.resource.data.n < 0 && request.resource.data.n >= -20)
        || (member() && request.resource.data.kind == 'gaveway' && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 2);
      allow delete: if admin() || (member() && resource.data.kind in ['spend', 'gaveway']);
    }
    // phones that said yes to notifications: each person saves and removes their own phone's address;
    // the chefs, and the job that sends the notifications, read them (and clear ones that stopped working)
    match /pushsubs/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'name', 'at'])
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() < 1000 && request.resource.data.endpoint.matches('https://.+')
        && request.resource.data.keys is map;
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }
    // photos and videos are stored in pieces under blobs/{id}/p/{n}
    match /blobs/{id}/p/{n} {
      allow read, write: if member();
    }
  }
}
